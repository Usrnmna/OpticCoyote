# Python bytecode, local environments, and test caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
/coverage.xml

# Optional installation-specific selector tuning; retain config.json as the audited default.
/rpi-ahd-selector/config.local.json
/rpi-ahd-selector/diagnostic.local.json
/rpi-ahd-selector/diagnostic-reports/
/rpi-oled-bridge/reverse.local.json
/rpi-oled-bridge/reverse-diagnostic.local.json
/rpi-oled-bridge/diagnostic-reports/
/rpi-buzzer/buzzer.local.json
# Backups of installation-specific settings; shipped defaults remain trackable.
*.local.json.bak
*.local.json.tmp

# Generated review/diagnostic runs with a workspace-level report destination.
# Synthetic fault-isolation logs belong here; authored docs and fixtures do not.
/reports/
/test-results/

# Local build directories and Arduino-generated firmware exports.
build/
.build/
# Debian packages, isolated APT caches, offline bundles, and build manifests.
/dist/
# Alternate repository-root output from --output-dir . packaging runs.
/apt-work-*/
/project-optic-coyote_*_all.deb
/project-optic-coyote_*_all.deb.sha256
/project-optic-coyote_*_all.json
/project-optic-coyote_*_trixie_arm64_offline*
*.ino.hex
*.ino.with_bootloader.hex
*.ino.elf
*.ino.eep
*.ino.bin

# Compiled intermediates and linker output.
*.o
*.obj
*.a
*.d
*.map
*.su

# Compiler-generated coverage data; retain authored test fixtures.
*.gcda
*.gcno
*.gcov

# Executables produced by the documented Nano host checks.
optic-coyote-*-test
optic-coyote-*-test.exe

# Operating-system folder metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Generated documentation caches; keep authored diagrams and exports trackable.
/docs/_build/
/docs/.cache/

# Editor recovery files and temporary Markdown copies.
*.swp
*.swo
*~
*.md.bak
*.md.tmp
